# ============================================================================
# Copy to .env.local and fill in real values. .env.local is gitignored.
# ============================================================================
#
# Assignment variable name          ->  Name used here
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_NEON_AUTH_URL         ->  VITE_NEON_AUTH_URL
# NEXT_PUBLIC_NEON_DATA_API_URL     ->  VITE_NEON_DATA_API_URL
#
# The assignment lists NEXT_PUBLIC_* names, which are the Next.js convention.
# This project's frontend is React + Vite, where only variables prefixed with
# VITE_ are exposed to the browser. The names differ; the values and their
# public/server-only split are exactly as the assignment specifies.


# --- Public: compiled into the browser bundle. Safe to expose. ---------------

# Managed Better Auth endpoint. The browser signs in and out directly here.
VITE_NEON_AUTH_URL="https://ep-example-123456.us-east-1.aws.neon.tech/neondb/auth"

# Neon Data API (PostgREST). Public by design -- RLS is what protects the rows,
# not the secrecy of this URL. The app does NOT query it from the browser
# (contact data goes through the Node backend); it is declared here for parity
# with the assignment's variable list, and scripts/rls-two-user-test.mjs points
# a real user's real token at it to prove RLS holds even when the URL is known.
VITE_NEON_DATA_API_URL="https://ep-example-123456.us-east-1.aws.neon.tech/neondb/rest/v1"


# --- Server-only: never sent to the browser. --------------------------------

# Used by the backend to fetch Neon's JWKS and verify incoming tokens.
NEON_AUTH_URL="https://ep-example-123456.us-east-1.aws.neon.tech/neondb/auth"

# The backend forwards each caller's own JWT to this endpoint, so every query
# runs with that user's identity and RLS applies.
NEON_DATA_API_URL="https://ep-example-123456.us-east-1.aws.neon.tech/neondb/rest/v1"

# Comma-separated origins allowed to call the API. Not needed in the deployed
# single-project setup, where frontend and backend share an origin.
CORS_ORIGINS="http://localhost:5173"


# --- Secret: local migrations ONLY ------------------------------------------

# Used only by `npm run db:migrate` to apply db/schema.sql.
# The application never reads this: not the backend, not the frontend, and it
# is deliberately NOT configured in Vercel. The deployed app reaches Postgres
# only through the Data API, where RLS is enforced.
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"


# --- Two-account privacy test (npm run test:rls) ----------------------------
# Two real accounts created through the app's sign-up form.
TEST_USER_A_EMAIL="usera@example.com"
TEST_USER_A_PASSWORD="replace-me"
TEST_USER_B_EMAIL="userb@example.com"
TEST_USER_B_PASSWORD="replace-me"

{
  "name": "networkingtracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend & npm run dev --workspace frontend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "db:migrate": "node db/migrate.mjs",
    "test:rls": "node scripts/rls-two-user-test.mjs"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
